# ==============================================================================
# SCHOOL STUDY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# These variables are exposed to the browser via NEXT_PUBLIC_ prefix.
# On Vercel: Configure these as "Plain text / Config" Environment Variables.
# Source: Firebase Console > Project Settings > General > Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. CANONICAL SITE DOMAIN (Production SEO)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://schoolstudy.in

# ------------------------------------------------------------------------------
# 3. OPTIONAL GOOGLE ANALYTICS (GA4)
# ------------------------------------------------------------------------------
# Set only if you have a Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE SECRETS (Optional — For Firebase Admin SDK)
# ------------------------------------------------------------------------------
# These variables are SERVER-ONLY and must NEVER have NEXT_PUBLIC_ prefix.
# On Vercel: Configure these as "Sensitive / Encrypted" Environment Variables.
# Source: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
# Or single-line JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY=
