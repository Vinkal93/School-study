# ==============================================================================
# SCHOOL STUDY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# These variables are exposed to the browser via NEXT_PUBLIC_ prefix.
# On Vercel: Configure these as "Plain text / Config" Environment Variables.
# Source: Firebase Console > Project Settings > General > Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. CANONICAL SITE DOMAIN (Production SEO & Redirects)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://school.sbci.online
NEXT_PUBLIC_APP_URL=https://school.sbci.online

# ------------------------------------------------------------------------------
# 3. OPTIONAL MONITORING & ANALYTICS
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Sentry Error Reporting DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE SECRETS (Required for Firebase Admin SDK)
# ------------------------------------------------------------------------------
# These variables are SERVER-ONLY and must NEVER have NEXT_PUBLIC_ prefix.
# On Vercel: Configure these as "Sensitive / Encrypted" Environment Variables.
# Source: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
# Or single-line JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY=
# Private Firebase Admin JSON file path (for local docker / dev):
# FIREBASE_SERVICE_ACCOUNT_PATH=

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Key ID is exposed to browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
# Secrets are STRICTLY SERVER-SIDE and MUST NEVER be exposed to the browser
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Toggle live gateway vs test mode
NEXT_PUBLIC_PAYMENT_GATEWAY_LIVE=false

# ------------------------------------------------------------------------------
# 6. TWILIO & COMMUNICATION SYSTEM CONFIGURATION (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Twilio WhatsApp/SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# Secret encryption key for AES-256-GCM encryption of provider credentials
COMMUNICATION_ENCRYPTION_KEY=
# Email provider (resend / smtp / none)
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_API_KEY=
EMAIL_SENDER_ADDRESS=notifications@schoolstudy.in
EMAIL_SENDER_NAME="School Study Platform"

# ------------------------------------------------------------------------------
# 7. CRON & SYSTEM MAINTENANCE SECRETS
# ------------------------------------------------------------------------------
CRON_SECRET=
BACKUP_CRON_SECRET=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 8. AI ENGINE CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
