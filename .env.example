# ==============================================================================
# SCHOOL STUDY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# These variables are exposed to the browser via NEXT_PUBLIC_ prefix.
# On Vercel: Configure these as "Plain text / Config" Environment Variables.
# Source: Firebase Console > Project Settings > General > Your Apps (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. CANONICAL SITE DOMAIN (Production SEO)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://schoolstudy.in

# ------------------------------------------------------------------------------
# 3. OPTIONAL GOOGLE ANALYTICS (GA4)
# ------------------------------------------------------------------------------
# Set only if you have a Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE SECRETS (Optional — For Firebase Admin SDK)
# ------------------------------------------------------------------------------
# These variables are SERVER-ONLY and must NEVER have NEXT_PUBLIC_ prefix.
# On Vercel: Configure these as "Sensitive / Encrypted" Environment Variables.
# Source: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
# Or single-line JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 5. RAZORPAY TEST MODE PAYMENT CONFIGURATION (Section 2)
# ------------------------------------------------------------------------------
# Key ID is exposed to browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
# Secrets are STRICTLY SERVER-SIDE and MUST NEVER be exposed to the browser
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional monitoring: set valid project DSNs; leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Private Firebase Admin JSON file, stored OUTSIDE the repository.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ------------------------------------------------------------------------------
# 6. TWILIO & COMMUNICATION SYSTEM CONFIGURATION (Server-Side Secrets)
# ------------------------------------------------------------------------------
# These variables configure the Twilio WhatsApp/SMS and Email messaging system.
# Source: Twilio Console > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender number format: whatsapp:+[country_code][number] (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional SMS sender (E.164 phone number or alphanumeric ID)
TWILIO_SMS_FROM=
# Secret encryption key for AES-256-GCM encryption at rest of provider credentials
COMMUNICATION_ENCRYPTION_KEY=
# Optional Email configuration
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_SENDER_ADDRESS=notifications@schoolstudy.in
EMAIL_SENDER_NAME=School Study Platform
