rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if caller is super_admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin') ||
        request.auth.token.get('role', '') == 'super_admin'
      );
    }

    // ==========================================
    // PAYMENT SETTINGS & CONFIG
    // ==========================================
    match /paymentSettings/{docId} {
      allow read, write: if true;
    }

    // ==========================================
    // PLANS & CATALOG
    // ==========================================
    match /plans/{planId} {
      allow read, write: if true;
    }

    match /planVersions/{versionId} {
      allow read, write: if true;
    }

    match /featureDefinitions/{featId} {
      allow read, write: if true;
    }

    match /accessPolicies/{policyId} {
      allow read, write: if true;
    }

    // ==========================================
    // SUBSCRIPTIONS & MULTI-TENANT BILLING
    // ==========================================
    match /schoolSubscriptions/{schoolId} {
      allow read, write: if true;

      match /history/{historyId} {
        allow read, write: if true;
      }
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /financeTransactions/{txId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /couponRedemptions/{redemptionId} {
      allow read, write: if true;
    }

    match /refunds/{refundId} {
      allow read, write: if true;
    }

    match /disputes/{disputeId} {
      allow read, write: if true;
    }

    match /subscriptionAdjustments/{adjId} {
      allow read, write: if true;
    }

    match /accessOverrides/{overrideId} {
      allow read, write: if true;
    }

    match /limitOverrides/{overrideId} {
      allow read, write: if true;
    }

    match /penalties/{penaltyId} {
      allow read, write: if true;
    }

    match /financialAdjustments/{finId} {
      allow read, write: if true;
    }

    match /customOffers/{offerId} {
      allow read, write: if true;
    }

    match /customPlanAccess/{accessId} {
      allow read, write: if true;
    }

    // ==========================================
    // CMS & SITE CONTROL
    // ==========================================
    match /siteSettings/{docId} {
      allow read, write: if true;
    }

    match /siteSettingsVersions/{versionId} {
      allow read, write: if true;
    }

    // ==========================================
    // CONTACT INQUIRIES & CRM
    // ==========================================
    match /contactInquiries/{inquiryId} {
      allow read, write: if true;

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read, write: if true;
    }

    // ==========================================
    // SCHOOLS & SUBCOLLECTIONS
    // ==========================================
    match /schools/{schoolId} {
      allow read, write: if true;

      match /{collection}/{docId} {
        allow read, write: if true;
      }
    }

    // ==========================================
    // AUDIT LOGS & PLATFORM COLLECTIONS
    // ==========================================
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /login_logs/{logId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /account_restrictions/{docId} {
      allow read, write: if true;
    }

    match /platform_analytics/{docId} {
      allow read, write: if true;
    }

    // Fallback: Disallow anything unspecified
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
