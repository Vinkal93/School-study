rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if caller is super_admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin') ||
        request.auth.token.get('role', '') == 'super_admin'
      );
    }

    // Helper: Is owner or user self?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // SENSITIVE FINANCIAL & SUBSCRIPTION COLLECTIONS
    // Server-Only Write Access (Client write forbidden to prevent tampering)
    // ==========================================
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /planVersions/{versionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /featureDefinitions/{featId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /accessPolicies/{policyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /schoolSubscriptions/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /schoolSubscriptions/{schoolId}/history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /financeTransactions/{txId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /couponRedemptions/{redemptionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // CMS & SITE CONTROL
    // ==========================================
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /siteSettingsVersions/{versionId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // CONTACT INQUIRIES
    // ==========================================
    match /contactInquiries/{inquiryId} {
      allow read: if isSuperAdmin();
      allow create: if true; // Public contact form submission
      allow update, delete: if isSuperAdmin();

      match /notes/{noteId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // SCHOOLS & NESTED COLLECTIONS (MULTI-TENANT)
    // ==========================================
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();

      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // ==========================================
    // AUDIT LOGS & PLATFORM PRIVILEGED COLLECTIONS
    // Absolute Immutability: Update and delete are strictly forbidden
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /login_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /account_restrictions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /platform_analytics/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // AGGREGATED STATS COLLECTIONS
    // ==========================================
    match /schoolStats/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /platformStats/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /dailyStats/{date} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Default Fallback: Authenticated access required
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
