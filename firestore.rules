rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SECURITY HELPER FUNCTIONS
    // ==========================================

    // Helper: Is user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is user Super Admin?
    // Finding 1: Strict server-managed claims and authoritative user profile check only.
    // Removed all insecure email regex/pattern wildcards.
    function isSuperAdmin() {
      return isAuthenticated() && (
        // Check for Super Admin role in cryptographically verified token claims
        request.auth.token.get('role', '') == 'super_admin' ||
        request.auth.token.get('isSuperAdmin', false) == true ||
        // Trusted server-managed identity document in Firestore
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin')
      );
    }

    // Helper: Does user belong to target school?
    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.get('schoolId', '') == schoolId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('schoolId', '') == schoolId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin'
        ))
      );
    }

    // Helper: Is user School Admin for target school?
    function isSchoolAdmin(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isSchoolMember(schoolId) && (
          request.auth.token.get('role', '') in ['admin', 'school_admin'] ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'school_admin'])
        ))
      );
    }

    // Helper: Is user Teacher for target school?
    function isTeacher(schoolId) {
      return isAuthenticated() && (
        isSchoolAdmin(schoolId) ||
        (isSchoolMember(schoolId) && (
          request.auth.token.get('role', '') in ['teacher', 'TEACHER'] ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['teacher', 'TEACHER']) ||
          exists(/databases/$(database)/documents/schools/$(schoolId)/teachers/$(request.auth.uid))
        ))
      );
    }

    // Helper: Is user updating their own profile without escalating role/school/permissions?
    function isSelfProfileValid(userId) {
      return isAuthenticated() && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'schoolId', 'status', 'uid', 'isSuperAdmin', 'forceLogout', 'requireReLogin', 'permissions'
        ])
      );
    }

    // ==========================================
    // 1. USERS COLLECTION (Finding 2)
    // ==========================================
    match /users/{userId} {
      // User can read own doc; School Admin can read members of own school; Super Admin can read all
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', '')))
      );

      // Create: Authenticated, UID-bound, role-restricted, field-allowlisted profile creation
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          // Cannot self-assign administrative roles
          request.resource.data.get('role', 'student') in ['student', 'parent', 'teacher'] &&
          // Cannot self-assign status other than active/pending
          request.resource.data.get('status', 'active') in ['active', 'pending'] &&
          // UID must match path
          request.resource.data.get('uid', userId) == userId &&
          // Allowlisted profile fields
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'name', 'phone', 'role', 'schoolId', 'status',
            'createdAt', 'updatedAt', 'avatar', 'photoUrl', 'studentId',
            'classId', 'sectionId', 'address', 'gender', 'dob', 'bloodGroup',
            'parentName', 'parentPhone', 'guardianName', 'guardianPhone', 'rollNumber'
          ])
        )
      );

      // Update: User can update own profile (without role escalation); Super Admin can update any; School Admin can manage student/teacher
      allow update: if isSuperAdmin() || isSelfProfileValid(userId) || (
        isAuthenticated() &&
        resource != null &&
        isSchoolAdmin(resource.data.get('schoolId', '')) &&
        resource.data.get('role', '') in ['student', 'teacher', 'parent']
      );

      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 2. SCHOOLS & TENANT SUBCOLLECTIONS (Finding 4, Finding 7)
    // ==========================================
    match /schools/{schoolId} {
      // Read: Public metadata allowed for code check & public portal; or School Member / Super Admin
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin()) ||
                     (resource != null && resource.data.get('isPublic', true) == true);

      // Create: Authorized Super Admin or server-side onboarding only (Backend API uses Admin SDK)
      allow create: if isSuperAdmin();

      // Update/Delete: School Admin for own school or Super Admin
      allow update, delete: if isSchoolAdmin(schoolId);

      // Homework subcollection: Teachers & Admins can write; all school members can read
      match /homework/{homeworkId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isTeacher(schoolId);
      }

      // Bells/Timetable subcollection: Admins can write; all school members can read
      match /bells/{bellId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }

      // Notifications subcollection: School members can read; Admins & Teachers can create; School members can ONLY update read status (Finding 7)
      match /notifications/{notificationId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isSchoolMember(schoolId) && (isSchoolAdmin(schoolId) || isTeacher(schoolId));
        allow update: if isSchoolMember(schoolId) && (
          isSchoolAdmin(schoolId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'isRead', 'readAt', 'readBy', 'viewedAt', 'status', 'acknowledged'
          ])
        );
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Nested Tenant Subcollections at ANY depth (classes, sections, students, teachers, academicYears, etc.)
      match /{allSubcollections=**} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolAdmin(schoolId);
      }
    }

    // ==========================================
    // 2d. SCHOOL USAGE COLLECTION (Finding 5)
    // ==========================================
    // School usage tracking is strictly read-only for school members and modifiable only by Super Admin / Server
    match /schoolUsage/{schoolId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolMember(schoolId)
      );
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 2b. TOP-LEVEL ATTENDANCE COLLECTION (Finding 6)
    // ==========================================
    match /attendance/{recordId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.get('schoolId', '') is string &&
          request.resource.data.get('schoolId', '') != '' &&
          (isSchoolAdmin(request.resource.data.get('schoolId', '')) || isTeacher(request.resource.data.get('schoolId', '')))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource != null &&
          // Tenant ID immutability: schoolId cannot be changed
          request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
          (isSchoolAdmin(resource.data.get('schoolId', '')) || isTeacher(resource.data.get('schoolId', '')))
        )
      );
      allow delete: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', '')));
    }

    // ==========================================
    // 2b-2. TOP-LEVEL EMPLOYEE ATTENDANCE COLLECTION (Finding 6)
    // ==========================================
    match /employee_attendance/{recordId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.get('schoolId', '') is string &&
          request.resource.data.get('schoolId', '') != '' &&
          isSchoolAdmin(request.resource.data.get('schoolId', ''))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource != null &&
          // Tenant ID immutability: schoolId cannot be changed
          request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
          isSchoolAdmin(resource.data.get('schoolId', ''))
        )
      );
      allow delete: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', '')));
    }

    // ==========================================
    // 2c. TOP-LEVEL NOTICES COLLECTION
    // ==========================================
    match /notices/{noticeId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.get('schoolId', '') is string &&
          isSchoolAdmin(request.resource.data.get('schoolId', ''))
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource != null &&
          request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
          isSchoolAdmin(resource.data.get('schoolId', ''))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', '')))
      );
    }

    // ==========================================
    // 3. SUBSCRIPTIONS, ORDERS & INVOICES (Finding 3)
    // ==========================================
    match /schoolSubscriptions/{schoolId} {
      allow read: if isSuperAdmin() || isSchoolMember(schoolId);
      allow write: if isSuperAdmin();

      // Subscription history: Strictly protected (Finding 3)
      match /history/{historyId} {
        allow read: if isSuperAdmin() || isSchoolMember(schoolId);
        allow write: if isSuperAdmin();
      }
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /financeTransactions/{txId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /couponRedemptions/{redemptionId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 3b. FEE MANAGEMENT COLLECTIONS (Tenant-Isolated)
    // ==========================================
    match /feeStructures/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow create, update, delete: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /studentFeeAssignments/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow create, update, delete: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /feePayments/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow create, update, delete: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /feeDiscounts/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow create, update, delete: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /feeSettings/{schoolId} {
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin());
      allow write: if isAuthenticated() && (isSchoolAdmin(schoolId) || isSuperAdmin());
    }

    // ==========================================
    // 3c. DOUBLE-ENTRY ACCOUNTING & LEDGER (Tenant-Isolated)
    // ==========================================
    match /feeDemands/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /financialPayments/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /paymentAllocations/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /financialRefunds/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /paymentReversals/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /feeAdjustments/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /studentLedgerEntries/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /chartOfAccounts/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /accountingJournals/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /journalEntries/{entryId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /cashBankAccounts/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /cashBankTransactions/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /financialStatements/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /feeFollowUps/{followUpId} {
      allow read, write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    // ==========================================
    // 3d. INQUIRIES & PARENT LEADS
    // ==========================================
    match /inquiries/{id} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow create: if true; // Public website contact and inquiry leads
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', '')))
      );

      match /activities/{activityId} {
        allow read, write: if isAuthenticated() && (
          isSuperAdmin() ||
          (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
        );
      }

      match /notes/{noteId} {
        allow read, write: if isSuperAdmin();
      }
    }

    match /contactInquiries/{id} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow create: if true; // Public contact form
      allow update, delete: if isSuperAdmin();

      match /notes/{noteId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // ==========================================
    // 3e. ACADEMIC & SCHOOL COLLECTIONS (TOP-LEVEL)
    // ==========================================
    match /academicYears/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) || (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', '')));
    }

    match /classes/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) || (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', '')));
    }

    match /sections/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) || (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', '')));
    }

    match /teachers/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) || (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', '')));
    }

    match /students/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        resource.data.get('studentId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) || (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', '')));
    }

    match /bells/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) || (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', '')));
    }

    match /homework/{id} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolMember(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin() || (resource != null && isTeacher(resource.data.get('schoolId', ''))) || (request.resource != null && isTeacher(request.resource.data.get('schoolId', '')));
    }

    // ==========================================
    // 4. PRICING PLANS, FEATURE BLUEPRINTS & OVERRIDES
    // ==========================================
    match /plans/{planId} {
      allow read: if true; // Public pricing page
      allow write: if isSuperAdmin();
    }

    match /planVersions/{versionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /featureDefinitions/{featId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /accessPolicies/{policyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /customOffers/{offerId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /customPlanAccess/{accessId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /accessOverrides/{overrideId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /schoolFeatureOverrides/{overrideId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /featureControlAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    match /limitOverrides/{overrideId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && (
          resource.data.get('userId', '') == request.auth.uid ||
          (resource.data.get('schoolId', '') != '' && isSchoolMember(resource.data.get('schoolId', '')))
        ))
      );
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        request.resource.data.get('schoolId', '') != '' &&
        (isSchoolAdmin(request.resource.data.get('schoolId', '')) || isTeacher(request.resource.data.get('schoolId', '')))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && resource.data.get('userId', '') == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt', 'status']))
      );
      allow delete: if isSuperAdmin();
    }

    match /penalties/{penaltyId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /financialAdjustments/{finId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /subscriptionAdjustments/{adjId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    match /subscriptionNotifications/{id} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource != null && isSchoolMember(resource.data.get('schoolId', '')))
      );
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 5. PAYMENT SETTINGS & SECRETS
    // ==========================================
    match /paymentSettings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 6. CMS & SITE SETTINGS
    // ==========================================
    match /siteSettings/{docId} {
      // Public landing/branding settings can be read publicly; control settings require auth.
      // communication_secrets is STRICTLY SERVER-ONLY and completely blocked from client reads/writes.
      allow read: if (docId in ['branding', 'landing_page', 'footer', 'seo_metadata'] || isAuthenticated()) && docId != 'communication_secrets';
      allow write: if isSuperAdmin() && docId != 'communication_secrets';
    }

    match /siteSettingsVersions/{versionId} {
      allow read, write: if isSuperAdmin();
    }

    match /feature_showcases/{showcaseId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /feature_showcase_views/{viewId} {
      allow read, write: if isAuthenticated();
    }

    match /schoolEmergency/{schoolId} {
      allow read: if isAuthenticated() && (isSchoolMember(schoolId) || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /userSecurityControl/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 7. AUDIT & LOGGING (IMMUTABLE APPEND-ONLY)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    match /login_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    match /activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    match /active_sessions/{sessionId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid);
    }

    match /account_restrictions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /platform_analytics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 8. BACKUP & CLOUD STORAGE
    // ==========================================
    match /backup_configs/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /backup_sync_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /backup_snapshots/{snapId} {
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 9. AI WORKSPACE & INTELLIGENCE
    // ==========================================
    match /ai_conversations/{convId} {
      allow read, delete, update: if isAuthenticated() && (resource == null || resource.data.get('userId', '') == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() || isSuperAdmin();
    }

    match /ai_messages/{msgId} {
      allow read, create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /ai_usage/{usageId} {
      allow read, create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // 10. COMMUNICATION ENGINE & AUTOMATION
    // ==========================================
    match /communication_delivery_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    match /communicationLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        isSchoolAdmin(resource.data.get('schoolId', '')) ||
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /communicationTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /feeAutomationRules/{ruleId} {
      allow read, write: if isAuthenticated() && (
        (request.resource != null && isSchoolAdmin(request.resource.data.get('schoolId', ''))) ||
        (resource != null && isSchoolAdmin(resource.data.get('schoolId', ''))) ||
        isSuperAdmin()
      );
    }

    match /billingProfiles/{schoolId} {
      allow read: if isSchoolMember(schoolId) || isSuperAdmin();
      allow create, update: if (isSchoolAdmin(schoolId) || isSuperAdmin()) && request.resource.data.schoolId == schoolId;
      allow delete: if isSuperAdmin();
    }

    match /paymentMethods/{schoolId} {
      allow read: if isSchoolMember(schoolId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 11. DEFAULT CATCH-ALL (DENY-BY-DEFAULT)
    // ==========================================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
