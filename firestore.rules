rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // ==========================================
    // USERS COLLECTION
    // Allow read so login portal role verification and initial setup check work seamlessly
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || !exists(/databases/$(database)/documents/users/$(userId));
    }

    // ==========================================
    // SCHOOLS & NESTED COLLECTIONS
    // ==========================================
    match /schools/{schoolId} {
      allow read: if true; // Allows school code check during student/teacher login
      allow write: if isAuthenticated();

      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // TOP-LEVEL COLLECTIONS
    // ==========================================
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
