rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user document from Firestore (safe fallback if doc exists)
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Helper: Check user role
    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().get('role', '') == role ||
        request.auth.token.get('role', '') == role
      );
    }

    function isSuperAdmin() {
      return hasRole('super_admin') || (isAuthenticated() && request.auth.token.get('email', '').matches('.*superadmin.*'));
    }

    function isSchoolAdmin() {
      return isSuperAdmin() || hasRole('school_admin') || (isAuthenticated() && request.auth.token.get('email', '').matches('.*admin.*'));
    }

    function isTeacher() {
      return isSchoolAdmin() || hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // User can always read/write their own profile doc
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSchoolAdmin() || isSuperAdmin());
    }

    // ==========================================
    // SCHOOLS & NESTED ACADEMIC COLLECTIONS
    // ==========================================
    match /schools/{schoolId} {
      allow read, write: if isAuthenticated();

      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // TOP-LEVEL COLLECTIONS
    // ==========================================
    match /academic_years/{yearId} {
      allow read, write: if isAuthenticated();
    }

    match /classes/{classId} {
      allow read, write: if isAuthenticated();
    }

    match /sections/{sectionId} {
      allow read, write: if isAuthenticated();
    }

    match /teachers/{teacherId} {
      allow read, write: if isAuthenticated();
    }

    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    match /attendance/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /notices/{noticeId} {
      allow read, write: if isAuthenticated();
    }

    match /teacherAssignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
