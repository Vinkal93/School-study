rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if caller is super_admin
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'super_admin';
    }

    // Helper: Check if caller belongs to target school
    function isSchoolMember(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.get('schoolId', '') == schoolId
      );
    }

    // Public uploads / profile avatars: Max 5MB, images only
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Multi-tenant school documents & photos: Max 15MB, strictly isolated by schoolId
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if isSchoolMember(schoolId);
      allow write: if isSchoolMember(schoolId)
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Default Fallback
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
