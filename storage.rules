rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if caller is super_admin
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'super_admin';
    }

    // Public uploads / profile avatars: Max 5MB, images only
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Multi-tenant school documents & photos: Max 10MB, isolated by schoolId
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Default Fallback
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
