rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // Under 5MB
    }

    // ==========================================
    // SCHOOL LOGOS: schools/{schoolId}/logo/{filename}
    // ==========================================
    match /schools/{schoolId}/logo/{allPaths=**} {
      // Logos can be read by any authenticated user for app branding
      allow read: if isAuthenticated();
      // Only authenticated users with image validation can upload
      allow write: if isAuthenticated() && isImage();
    }

    // ==========================================
    // STUDENT PHOTOS: students/{studentId}/profile/{filename}
    // ==========================================
    match /students/{studentId}/profile/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage();
    }

    // ==========================================
    // TEACHER PHOTOS: teachers/{teacherId}/profile/{filename}
    // ==========================================
    match /teachers/{teacherId}/profile/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage();
    }

    // Legacy fallback paths
    match /school-logos/{allPaths=**} {
      allow read, write: if isAuthenticated() && isImage();
    }
    match /student-photos/{allPaths=**} {
      allow read, write: if isAuthenticated() && isImage();
    }
    match /teacher-photos/{allPaths=**} {
      allow read, write: if isAuthenticated() && isImage();
    }
  }
}
