# ==========================================
# SCHOOLSTUDY SAAS — PRODUCTION ENVIRONMENT
# ==========================================

# Firebase Web App Credentials (from Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_production_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_production_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_production_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_production_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_production_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_production_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_production_measurement_id

# Optional: Next.js App Base URL
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
